# built application files
*.apk
*.ap_

# files for the dex VM
*.dex

# Java class files
*.class

# generated files
bin/
gen/
target/
build/
**/*.project
**/*.classpath

# Local configuration file (sdk path, etc)
local.properties
build.xml

# Backup files
*~

#eclipse project files
.metadata
.settings
#IntelliJ project files
.idea
*.iml
gen-external-apklibs
out
#transifex downloads
contributers.py

# View hierarchy captures
captures
# other
*.odg#
proguard
libs
*.DS_Store
*.keystore
*.p12
/secrets.properties
/app/*.jks
/app/google-services.json
.gradle/

# pixi
.pixi/

# Vendored ad-SDK aars used by the `free` flavor (flatDir in the root build.gradle).
# They live in a `libs` directory, which the blanket `libs` rule above would drop.
!lib/common/libs/
!lib/common/libs/*.aar
