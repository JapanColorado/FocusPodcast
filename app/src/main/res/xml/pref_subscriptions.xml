<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <dev.russell.yagi.common.common.prefs.supportv7.ATEPreferenceCategory
        android:layout="@layout/preference_category_title"
        android:title="@string/discover">
        <dev.russell.yagi.fragment.pref.PodcastSearchEnginePreference
            android:key="pref_podcast_search_engine"
            android:layout="@layout/list_item_view"
            android:summary="@string/pref_podcast_search_engine_sum"
            android:title="@string/pref_podcast_search_engine_title"
            app:icon="@drawable/ic_podcast_search" />
    </dev.russell.yagi.common.common.prefs.supportv7.ATEPreferenceCategory>

    <dev.russell.yagi.common.common.prefs.supportv7.ATEPreferenceCategory
        android:layout="@layout/preference_category_title"
        android:title="@string/pref_mobileUpdate_title">
        <dev.russell.yagi.common.common.prefs.supportv7.ATEPreference
            android:icon="@drawable/ic_refresh"
            android:key="pref_auto_refresh_interval"
            android:layout="@layout/list_item_view_no_title"
            android:summary="@string/feed_refresh_sum"
            android:title="@string/feed_refresh_title" />
        <dev.russell.yagi.common.common.prefs.supportv7.ATESwitchPreference
            android:defaultValue="false"
            android:key="pref_refresh_on_start"
            android:layout="@layout/list_item_view_switch_no_title"
            android:title="@string/pref_refresh_on_start_title" />
    </dev.russell.yagi.common.common.prefs.supportv7.ATEPreferenceCategory>

    <dev.russell.yagi.common.common.prefs.supportv7.ATEPreferenceCategory
        android:layout="@layout/preference_category_title"
        android:title="@string/library_label">
        <dev.russell.yagi.common.common.prefs.supportv7.ATEListPreference
            android:defaultValue="0"
            android:entries="@array/nav_drawer_feed_counter_options"
            android:entryValues="@array/nav_drawer_feed_counter_values"
            android:key="pref_feed_counts"
            android:layout="@layout/list_item_view"
            android:summary="@string/pref_nav_drawer_episodes_counter_sum"
            android:title="@string/pref_nav_drawer_episodes_counter_title"
            app:icon="@drawable/ic_round_exposure_plus_1_24" />
        <dev.russell.yagi.common.common.prefs.supportv7.ATESwitchPreference
            android:defaultValue="false"
            android:key="pref_show_sub_title"
            android:layout="@layout/list_item_view_switch_no_title"
            android:title="@string/pref_show_subscription_title"
            app:icon="@drawable/ic_round_title_24" />
    </dev.russell.yagi.common.common.prefs.supportv7.ATEPreferenceCategory>
</PreferenceScreen>
