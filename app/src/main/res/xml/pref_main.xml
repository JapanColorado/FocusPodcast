<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:search="http://schemas.android.com/apk/res-auto">

    <!-- 2.0.0 worked; 2.1.0 has a bug with custom strings, so override them by declaring resources with the same names -->
    <allen.town.podcast.searchpreference.SearchPreference
        android:key="searchPreference"
        search:textClearHistory="@string/searchpreference_clear_history"
        search:textHint="@string/preference_search_hint"
        search:textNoResults="@string/preference_search_no_results" />

    <allen.town.podcast.common.common.prefs.supportv7.ATEPreference
        android:icon="@drawable/ic_appearance"
        android:key="pref_appearance"
        android:layout="@layout/list_item_view_no_title_main"
        android:summary="@string/pref_appearance_sum"
        android:title="@string/appearance" />

    <allen.town.podcast.common.common.prefs.supportv7.ATEPreference
        android:icon="@drawable/ic_sound_waves"
        android:key="pref_playback"
        android:layout="@layout/list_item_view_no_title_main"
        android:summary="@string/playback_pref_sum"
        android:title="@string/playback_pref" />

    <allen.town.podcast.common.common.prefs.supportv7.ATEPreference
        android:icon="@drawable/ic_skip_24dp"
        android:key="pref_ad_skip"
        android:layout="@layout/list_item_view_no_title_main"
        android:summary="@string/pref_ad_skip_sum"
        android:title="@string/pref_ad_skip_category" />

    <allen.town.podcast.common.common.prefs.supportv7.ATEPreference
        android:icon="@drawable/ic_podcast"
        android:key="pref_subscriptions"
        android:layout="@layout/list_item_view_no_title_main"
        android:summary="@string/pref_subscriptions_updates_sum"
        android:title="@string/pref_subscriptions_updates_title" />

    <allen.town.podcast.common.common.prefs.supportv7.ATEPreference
        android:icon="@drawable/ic_network"
        android:key="pref_netword"
        android:layout="@layout/list_item_view_no_title_main"
        android:summary="@string/network_pref_sum"
        android:title="@string/network_pref" />
    <allen.town.podcast.common.common.prefs.supportv7.ATEPreference
        android:icon="@drawable/ic_storage"
        android:key="pref_storage"
        android:layout="@layout/list_item_view_no_title_main"
        android:summary="@string/storage_sum"
        android:title="@string/storage_pref" />
    <allen.town.podcast.common.common.prefs.supportv7.ATEPreference
        android:icon="@drawable/ic_cloud"
        android:key="pref_sync"
        android:layout="@layout/list_item_view_no_title_main"
        android:summary="@string/synchronization_sum"
        android:title="@string/synchronization_pref" />



    <allen.town.podcast.common.common.prefs.supportv7.ATEPreference
        android:icon="@drawable/ic_notifications"
        android:key="notifications"
        android:layout="@layout/list_item_view_no_title_main"
        android:title="@string/notification_pref_fragment" />

    <allen.town.podcast.common.common.prefs.supportv7.ATEPreference
        android:icon="@drawable/ic_others"
        android:key="others"
        android:layout="@layout/list_item_view_no_title_main"
        android:title="@string/others" />

    <allen.town.podcast.common.common.prefs.supportv7.ATEPreference
        android:icon="@drawable/ic_bug"
        android:key="pref_report_bug"
        android:layout="@layout/list_item_view_no_title_main"
        android:title="@string/bug_report_title" />
    <allen.town.podcast.common.common.prefs.supportv7.ATEPreference
        android:icon="@drawable/round_attach_money_24"
        android:key="pref_donate"
        search:isPreferenceVisible="false"
        android:layout="@layout/list_item_view_no_title_main"
        android:summary="@string/donate_summary"
        android:title="@string/donate" />
    <allen.town.podcast.common.common.prefs.supportv7.ATEPreference
        android:icon="@drawable/ic_info"
        android:key="pref_about"
        android:layout="@layout/list_item_view_no_title_main"
        android:title="@string/about_pref" />
</androidx.preference.PreferenceScreen>
