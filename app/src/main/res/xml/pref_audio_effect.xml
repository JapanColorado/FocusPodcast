<?xml version="1.0" encoding="utf-8"?>
<!-- Same controls in the same order as Settings > Playback > Default audio effects and the
     player's Audio Effects dialog. They always show the values in effect for the podcast. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:search="http://schemas.android.com/apk/allen.town.podcast.searchpreference">

    <allen.town.podcast.common.common.prefs.supportv7.ATEListPreference
        android:defaultValue="0"
        android:persistent="false"
        android:entries="@array/clear_voice_options"
        android:entryValues="@array/clear_voice_values"
        android:icon="@drawable/ic_vocal_enhancement"
        android:key="feed_clear_voice_pref"
        android:layout="@layout/list_item_view"
        android:title="@string/voice_label" />
    <allen.town.podcast.common.common.prefs.supportv7.ATESwitchPreference
        android:defaultValue="false"
        android:persistent="false"
        android:key="feed_skip_silence"
        android:layout="@layout/list_item_view_switch_no_title"
        android:title="@string/pref_skip_silence_title"
        app:icon="@drawable/ic_trim" />
    <allen.town.podcast.common.common.prefs.supportv7.ATESwitchPreference
        android:defaultValue="false"
        android:persistent="false"
        android:icon="@drawable/ic_volume_adaption"
        android:key="feed_mono_pref"
        android:layout="@layout/list_item_view_switch_no_title"
        android:title="@string/stereo_to_mono" />

    <!-- Only while the podcast has its own effects. -->
    <allen.town.podcast.common.common.prefs.supportv7.ATEPreference
        android:key="feed_effects_reset_to_default"
        android:layout="@layout/list_item_view"
        android:persistent="false"
        android:summary="@string/reset_effects_to_default_sum"
        android:title="@string/reset_to_default"
        android:visible="false"
        app:icon="@drawable/ic_baseline_settings_backup_restore_24"
        search:ignore="true" />
    <allen.town.podcast.common.common.prefs.supportv7.ATEPreference
        android:key="feed_effects_set_as_default"
        android:layout="@layout/list_item_view"
        android:persistent="false"
        android:summary="@string/set_effects_as_default_sum"
        android:title="@string/set_as_default"
        android:visible="false"
        app:icon="@drawable/ic_round_check_circle_outline_24"
        search:ignore="true" />

</PreferenceScreen>
