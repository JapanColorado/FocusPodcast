<?xml version="1.0" encoding="utf-8"?>
<!--
    One bookmark: the episode's cover and title (only on the Bookmarks screen, gone in the
    player's per-episode tab), the position (with the podcast on the Bookmarks screen), the note,
    and the overflow menu.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/bookmarkCover"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:background="@color/non_square_icon_background"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_podcast_background"
        tools:src="@tools:sample/avatars" />

    <LinearLayout
        android:id="@+id/bookmarkText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bookmarkEpisodeTitle"
            style="@style/FocusPodcast.TextView.ListItemPrimaryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="2"
            tools:text="Episode title" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/bookmarkPosition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            tools:text="12:34 · Podcast" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/bookmarkNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="4"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:text="A note about this moment" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/bookmarkMenu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/bookmark_options"
        android:src="@drawable/ic_more_vert"
        app:tint="?android:attr/textColorSecondary" />
</LinearLayout>
