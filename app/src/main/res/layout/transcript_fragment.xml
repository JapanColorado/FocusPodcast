<?xml version="1.0" encoding="utf-8"?>
<!-- The Transcript page of the player's episode sheet: the lines, or a loading / error / empty state. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorSurface">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/transcriptList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:paddingHorizontal="@dimen/additional_horizontal_spacing"
        android:paddingBottom="48dp"
        android:visibility="gone" />

    <dev.russell.yagi.common.views.AccentProgressBar
        android:id="@+id/transcriptProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:contentDescription="@string/transcript_loading"
        android:indeterminateOnly="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/transcriptMessageContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/transcriptMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/transcriptRetry"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/retry_label"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
