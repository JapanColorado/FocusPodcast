<?xml version="1.0" encoding="utf-8"?>
<!-- A podcast's auto-download keyword filter (dialog/filter/KeywordFilterSheet). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/episode_filters_label"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/episode_filters_description"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?android:attr/textColorSecondary" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/keywordModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <dev.russell.focuspodcast.common.views.AccentMaterialOutlineBackgroundStatusButton
                android:id="@+id/keywordInclude"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/episode_filters_include" />

            <dev.russell.focuspodcast.common.views.AccentMaterialOutlineBackgroundStatusButton
                android:id="@+id/keywordExclude"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/episode_filters_exclude" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <dev.russell.focuspodcast.common.views.AccentTextInputLayout
            android:id="@+id/keywordInput"
            style="?attr/textInputOutlinedDenseStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/episode_filters_hint"
            app:endIconContentDescription="@string/episode_filters_add_term"
            app:endIconDrawable="@drawable/ic_add"
            app:endIconMode="custom">

            <dev.russell.focuspodcast.common.views.CursorAccentTextInputEditText
                android:id="@+id/keywordInputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:singleLine="true" />
        </dev.russell.focuspodcast.common.views.AccentTextInputLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/keywordTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="0dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:background="?android:attr/listDivider" />

        <dev.russell.focuspodcast.common.common.views.AccentMaterialSwitch
            android:id="@+id/keywordDurationSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/episode_filters_min_duration"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <dev.russell.focuspodcast.common.views.AccentTextInputLayout
            android:id="@+id/keywordDurationInput"
            style="?attr/textInputOutlinedDenseStyle"
            android:layout_width="120dp"
            android:layout_height="wrap_content">

            <dev.russell.focuspodcast.common.views.CursorAccentTextInputEditText
                android:id="@+id/keywordDurationText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="4"
                android:singleLine="true" />
        </dev.russell.focuspodcast.common.views.AccentTextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <dev.russell.focuspodcast.common.views.AccentMaterialTextButton
                android:id="@+id/keywordCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/cancel_label" />

            <dev.russell.focuspodcast.common.views.AccentMaterialButton
                android:id="@+id/keywordSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save_label" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
