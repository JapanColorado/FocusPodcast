<?xml version="1.0" encoding="utf-8"?>
<!-- Shown while a podcast has its own settings: "Reset to default" makes it follow the defaults
     again, "Set as default" makes its values the defaults first. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?colorSecondaryContainer"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="4dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/own_settings_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="8dp"
            android:text="@string/podcast_own_settings_applied"
            android:textColor="?colorSecondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reset_to_default"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reset_to_default" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/set_as_default"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/set_as_default" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
