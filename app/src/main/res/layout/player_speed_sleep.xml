<?xml version="1.0" encoding="utf-8"?>
<!--
    The playback speed and sleep timer buttons that sit centred between the elapsed and the
    total time labels. Hosts place it inside the time row with toEndOf txtvPosition and
    toStartOf txtvLength, so it can never overlap the times: when the room between them runs
    short the buttons narrow and their text shrinks instead. Both are 48dp tall for touch;
    the time row gives up that height with negative margins.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/audioplayer_playercontrols_length">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/txtvPlaybackSpeed"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="?roundSelector"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:maxLines="1"
        android:text="1.0x"
        android:textColor="?android:attr/textColorSecondary"
        app:autoSizeMaxTextSize="14sp"
        app:autoSizeMinTextSize="8sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toStartOf="@id/butSleepTimer"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="56dp" />

    <!-- Shows the moon icon while idle and the time left while running (set in code). -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/butSleepTimer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="?roundSelector"
        android:clickable="true"
        android:contentDescription="@string/sleep_timer_label"
        android:focusable="true"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="?android:attr/textColorSecondary"
        app:autoSizeMaxTextSize="14sp"
        app:autoSizeMinTextSize="8sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/txtvPlaybackSpeed"
        app:layout_constraintWidth_max="84dp"
        tools:text="12:34" />

</androidx.constraintlayout.widget.ConstraintLayout>
