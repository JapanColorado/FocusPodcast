<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="300dp"
        android:orientation="vertical">

        <allen.town.podcast.common.views.AccentMaterialButton
            android:id="@+id/audio_tracks"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <allen.town.podcast.common.views.AccentImageView
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_trim" />

            <allen.town.podcast.common.common.views.ATESwitch
                android:id="@+id/skipSilence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_skip_silence_title"
                android:thumb="@drawable/switch_thumb"
                app:track="@drawable/switch_track" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <allen.town.podcast.common.views.AccentImageView
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_volume_adaption" />

            <allen.town.podcast.common.common.views.ATESwitch
                android:id="@+id/stereo_to_mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stereo_to_mono"
                android:thumb="@drawable/switch_thumb"
                app:track="@drawable/switch_track" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <allen.town.podcast.common.views.AccentImageView
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_vocal_enhancement" />

            <allen.town.podcast.common.common.views.ATESwitch
                android:id="@+id/vocal_enhancement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vocal_enhancement"
                android:thumb="@drawable/switch_thumb"
                app:track="@drawable/switch_track" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/detect_ads_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <allen.town.podcast.common.views.AccentImageView
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_sound_waves" />

            <allen.town.podcast.common.common.views.ATESwitch
                android:id="@+id/detect_ads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/detect_ads"
                android:thumb="@drawable/switch_thumb"
                app:track="@drawable/switch_track" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/equalizer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?rectSelector"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <allen.town.podcast.common.views.AccentImageView
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_equalizer" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/equalizer"
                android:textColor="?android:textColorPrimary" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/own_settings_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:visibility="gone"
            app:cardBackgroundColor="?colorSecondaryContainer"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardPreventCornerOverlap="false"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="4dp">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/podcast_own_settings_applied"
                    android:textColor="?colorSecondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reset_to_default"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reset_to_default" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</ScrollView>

