<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="300dp"
        android:orientation="vertical">

        <allen.town.podcast.common.views.AccentMaterialButton
            android:id="@+id/audio_tracks"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <allen.town.podcast.common.views.AccentImageView
                style="@style/Widget.Material3.Button.IconButton"
                android:importantForAccessibility="no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_vocal_enhancement" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_label"
                    android:textColor="?android:textColorPrimary" />

                <!-- describes the selected mode -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/voice_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?android:textColorSecondary"
                    tools:text="@string/voice_clear_sum" />
            </LinearLayout>
        </LinearLayout>

        <!-- Full width rather than indented under the title, so four buttons fit on a phone. -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/clear_voice_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:contentDescription="@string/voice_label"
            app:selectionRequired="true"
            app:singleSelection="true">

            <allen.town.podcast.common.views.AccentMaterialOutlineBackgroundStatusButton
                android:id="@+id/voice_original"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/voice_original"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeTextType="uniform" />

            <allen.town.podcast.common.views.AccentMaterialOutlineBackgroundStatusButton
                android:id="@+id/voice_clear"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/voice_clear"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeTextType="uniform" />

            <allen.town.podcast.common.views.AccentMaterialOutlineBackgroundStatusButton
                android:id="@+id/voice_clear_plus"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/voice_clear_plus"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeTextType="uniform" />

            <allen.town.podcast.common.views.AccentMaterialOutlineBackgroundStatusButton
                android:id="@+id/voice_warm"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/voice_warm"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeTextType="uniform" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <allen.town.podcast.common.views.AccentImageView
                style="@style/Widget.Material3.Button.IconButton"
                android:importantForAccessibility="no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_trim" />

            <allen.town.podcast.common.common.views.ATESwitch
                android:id="@+id/skipSilence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_skip_silence_title"
                android:thumb="@drawable/switch_thumb"
                app:track="@drawable/switch_track" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <allen.town.podcast.common.views.AccentImageView
                style="@style/Widget.Material3.Button.IconButton"
                android:importantForAccessibility="no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_volume_adaption" />

            <allen.town.podcast.common.common.views.ATESwitch
                android:id="@+id/stereo_to_mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stereo_to_mono"
                android:thumb="@drawable/switch_thumb"
                app:track="@drawable/switch_track" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/detect_ads_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <allen.town.podcast.common.views.AccentImageView
                style="@style/Widget.Material3.Button.IconButton"
                android:importantForAccessibility="no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_sound_waves" />

            <allen.town.podcast.common.common.views.ATESwitch
                android:id="@+id/detect_ads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/detect_ads"
                android:thumb="@drawable/switch_thumb"
                app:track="@drawable/switch_track" />
        </LinearLayout>

        <include
            android:id="@+id/own_settings_card"
            layout="@layout/own_settings_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

</ScrollView>

