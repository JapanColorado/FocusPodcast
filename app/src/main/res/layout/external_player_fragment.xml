<?xml version="1.0" encoding="utf-8"?>
<!-- Removing fitsSystemWindows in main.xml gets rid of the blank space at the bottom, but without it the status bar color no longer works on non-MD3 themes -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragmentLayout"
    android:layout_width="match_parent"
    android:layout_height="@dimen/external_player_height"
    app:cardCornerRadius="0dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/imageTextContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            app:cardCornerRadius="6dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/drag_view"
            app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imgvCover"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@color/non_square_icon_background"
            android:contentDescription="@string/media_player"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            android:scaleType="centerCrop"
            tools:src="@tools:sample/backgrounds/scenic" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginLeft="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/txtvTitle"
                style="@style/Base.TextAppearance.AppCompat.Body1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Episode title that is too long and will cause the text to wrap" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/txtvAuthor"
                style="@style/TextAppearance.AppCompat.Body1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?android:attr/textColorSecondary"
                tools:text="Episode author that is too long and will cause the text to wrap" />
        </LinearLayout>

        <dev.russell.yagi.common.views.AccentImageView
            android:src="@drawable/mini_player_skip_back"
            android:id="@+id/butRev"
            android:layout_gravity="center_vertical"
            android:scaleType="center"
            android:background="?roundSelector"
            android:contentDescription="@string/rewind_label"
            android:padding="10dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-5dp"
            android:layout_marginEnd="-5dp"/>
        <!-- The progress ring measures 48dp (40dp indicator plus 4dp inset), so the frame was
             already 48dp wide and butPlay can fill it without moving anything. -->
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/episodeProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:trackCornerRadius="16dp"
                tools:progress="10" />

            <dev.russell.yagi.view.PlayButton
                android:id="@+id/butPlay"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="?roundSelector"
                android:padding="10dp"
                android:contentDescription="@string/pause_label"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/ic_play_48dp"
                tools:src="@drawable/ic_play_48dp" />
        </FrameLayout>
        <dev.russell.yagi.common.views.AccentImageView
            android:src="@drawable/mini_player_skip_forward"
            android:id="@+id/butFF"
            android:layout_gravity="center_vertical"
            android:background="?roundSelector"
            android:contentDescription="@string/fast_forward_label"
            android:scaleType="center"
            android:padding="10dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-5dp"
            android:layout_marginEnd="-5dp"/>
        <dev.russell.yagi.common.views.AccentImageView
            android:padding="8dp"
            android:id="@+id/queue_iv"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-4dp"
            android:layout_marginEnd="-4dp"
            android:background="?roundSelector"
            android:src="@drawable/ic_playlist"
            android:contentDescription="@string/playlist_label"
            android:layout_gravity="center_vertical"
            android:gravity="center"
            android:scaleType="centerCrop" />
    </LinearLayout>


</com.google.android.material.card.MaterialCardView>
