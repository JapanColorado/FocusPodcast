<?xml version="1.0" encoding="utf-8"?>
<resources>

    <string-array name="ad_skip_sensitivity_options">
        <item>@string/ad_skip_sensitivity_low</item>
        <item>@string/ad_skip_sensitivity_medium</item>
        <item>@string/ad_skip_sensitivity_high</item>
    </string-array>

    <!-- MUST stay in sync with AdSkipPrefs.SENSITIVITY_* in core -->
    <string-array name="ad_skip_sensitivity_values" translatable="false">
        <item>low</item>
        <item>medium</item>
        <item>high</item>
    </string-array>

    <!-- The Voice modes, in ClearVoiceLevel order -->
    <string-array name="clear_voice_options">
        <item>@string/voice_original</item>
        <item>@string/voice_clear</item>
        <item>@string/voice_clear_plus</item>
        <item>@string/voice_warm</item>
    </string-array>

    <!-- One line per Voice mode, same order; shown as the preference summary -->
    <string-array name="clear_voice_descriptions">
        <item>@string/voice_original_sum</item>
        <item>@string/voice_clear_sum</item>
        <item>@string/voice_clear_plus_sum</item>
        <item>@string/voice_warm_sum</item>
    </string-array>

    <!-- MUST stay in sync with ClearVoiceLevel in model -->
    <string-array name="clear_voice_values" translatable="false">
        <item>0</item>
        <item>1</item>
        <item>2</item>
        <item>3</item>
    </string-array>

</resources>
